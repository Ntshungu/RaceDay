@model LoginVm
@{ ViewData["Title"]="Log in"; }
<div class="auth-card card p-4 mx-auto"><h1>Welcome back</h1><p class="text-muted">Log in to your RaceDay account.</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post"><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" required></div>
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" required></div>
<button class="btn btn-primary w-100">Log in</button></form><p class="mt-3 mb-0">New here? <a asp-action="Register">Create an account</a>.</p></div>
