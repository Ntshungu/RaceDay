@model ProfileVm
@{ ViewData["Title"]="My profile"; }
<h1>My profile</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" enctype="multipart/form-data" class="card p-4">
@if(!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)){<img src="@Model.ProfilePictureUrl" class="profile-img mb-3" alt="Profile picture">}
<div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" required></div>
<div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control"></div>
<div class="mb-3"><label class="form-label">Profile picture</label><input asp-for="ProfilePicture" type="file" accept="image/*" class="form-control"></div>
<input type="hidden" asp-for="ProfilePictureUrl"><button class="btn btn-primary">Save profile</button></form>
