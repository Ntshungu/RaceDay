<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - RaceDay</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark rd-nav">
<div class="container">
<a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav">
<ul class="navbar-nav me-auto">
<li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
@if (Context.Session.GetString("RaceDayUser") is string userJson && !string.IsNullOrEmpty(userJson)) {
    var u = System.Text.Json.JsonSerializer.Deserialize<RaceDay.MVC.Models.UserResponse>(userJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
    if (u?.Role == "Organiser") { <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Organiser dashboard</a></li> }
    if (u?.Role == "Participant") { <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Dashboard">My enrolments</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a></li> }
    <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
}
</ul>
<div class="d-flex gap-2">
@if (Context.Session.GetString("RaceDayUser") is string logged && !string.IsNullOrEmpty(logged)) {
<form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Log out</button></form>
} else {
<a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
<a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Register</a>
}
</div>
</div></div></nav>
<main class="container py-4">
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@RenderBody()
</main>
<footer class="rd-footer"><div class="container">RaceDay • South African road running, walking and cycling events</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
