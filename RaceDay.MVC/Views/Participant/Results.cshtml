@model List<ResultVm>
@{ ViewData["Title"]="My results"; }
<h1>My race results</h1><p class="text-muted">Your performance history across completed events.</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>
@foreach(var r in Model){<tr><td>@r.EventName</td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.Category</td><td>@r.FinishTime</td><td>@r.FinishingPosition of @r.TotalFinishers</td></tr>}
</tbody></table></div>
