@model List<EventVm>
@{ ViewData["Title"]="Organiser dashboard"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Organiser dashboard</h1><p class="text-muted">Manage your events and participants.</p></div><a class="btn btn-warning" asp-action="Create">+ Create event</a></div>
@if (!string.IsNullOrEmpty(ViewBag.Error)) { <div class="alert alert-warning">@ViewBag.Error</div> }
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat"><small>Your events</small><strong>@Model.Count</strong></div></div><div class="col-md-4"><div class="stat"><small>Upcoming events</small><strong>@Model.Count(e=>e.EventDate>=DateTime.Today)</strong></div></div></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Distance</th><th>Enrolments</th><th>Actions</th></tr></thead><tbody>
@foreach(var e in Model){<tr><td>@e.Name</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.Distance km</td><td>@e.Enrolments.Count</td><td class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.EventId">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments/results</a><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@e.EventId"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}
</tbody></table></div>
