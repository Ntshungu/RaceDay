@model List<EventVm>
@{ ViewData["Title"]="Events"; }
<h1>Discover events</h1><p class="text-muted">Find your next run, walk or cycle.</p>
@if (!string.IsNullOrEmpty(ViewBag.Error)) { <div class="alert alert-warning">@ViewBag.Error</div> }
<div class="row g-3">
@foreach(var e in Model) {
<div class="col-md-4"><div class="card event-card h-100">
@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img src="@e.BannerImageUrl" class="card-img-top event-img" alt="Event banner">}
<div class="card-body"><span class="badge text-bg-primary">@e.EventType</span><h5 class="mt-2">@e.Name</h5><p>@e.Location</p><p>@e.EventDate.ToString("dd MMM yyyy") • @e.Distance km</p><a class="btn btn-primary" asp-action="Details" asp-route-id="@e.EventId">Details and categories</a></div></div></div>
}
</div>
